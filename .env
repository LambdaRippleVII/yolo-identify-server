# =============================================================================
# 服务器配置
# =============================================================================

# 服务器标题
SERVER_TITLE=YOLO识别服务器
# 服务器版本
SERVER_VERSION=1.0.0
# 服务器主机地址，如果配置0.0.0.0则为广播(服务器当前能连接上的所有ip均可访问)
SERVER_HOST=0.0.0.0
# 服务器端口号
SERVER_PORT=18848
# Openapi文档路径配置，将路径配置为空则禁用文档
DOCS_URL=/yolo-api/docs-ui
REDOC_URL=/yolo-api/redoc-ui
OPENAPI_URL=/yolo-api/openapi-conf.json

# =============================================================================
# MQTT相关配置
# =============================================================================

# 服务器ip
MQTT_BROKER_IP=127.0.0.1
# 端口
MQTT_BROKER_PORT=18830
# 账号(如果为空则为匿名登录)
MQTT_USERNAME=admin
# 密码(如果为空则为匿名登录)
MQTT_PASSWORD=admin123
# id
MQTT_CLIENT_ID=yolo-server

# =============================================================================
# 模型配置相关
# =============================================================================

# 视频源地址,如果为具体数字则为查找本地摄像头(usb摄像头)，如果为rtsp流地址则为访问对应的网络摄像头
CAP_SOURCE=0
# 当前使用的模型名称或地址
# 可以配置模型名称，如果只放模型名称没有类型，则默认为模型名称为模型名称+.pt，此时服务器会在项目根目录(main.py)所在目录的yolo_models文件夹中寻找
# 如果配置模型地址，则必须配置模型的绝对路径，此字段为代码中引用，相对路径大概率会导致无法找到模型
MODEL_PATH=yolo11n.pt
# 模型配置文件名称或地址
# 可以配置模型名称，如果只放模型名称没有类型，则默认为模型名称为模型名称+.yaml，此时服务器会在项目根目录(main.py)所在目录中寻找
# 如果配置模型地址，则必须配置模型的绝对路径，此字段为代码中引用，相对路径大概率会导致无法找到模型
# 如果留空则为不使用配置(即放行所有识别)
MODEL_CONFIG_PATH=modelConfig.yaml

# =============================================================================
# 接入设备配置
# =============================================================================

# 当前此服务产品ID
PRODUCT_ID=11111
# 当前此服务设备ID
DEVICE_ID=22222
# 数据上报最小间隔时间(毫秒)
REPORT_MIN_INTERVAL=5000
# 上行主题规则
# 这个的配置为动态的，使用大括号包裹的在代码中会替换为具体的配置，没有被包裹的则完整保留
UP_TOPIC_RULE=/{PRODUCT_ID}/{DEVICE_ID}/properties/report
# 发布时的Qos，只能选择0、1、2.选择其他的可能报错  【qos: 0 (最多一次), 1 (至少一次), 2 (只有一次)】
UP_QOS=1
# 发送消息的json配置文件名称或者地址,json文件配置规则见Readme.md中的"发送消息json配置"
# 可以配置模型名称，如果只放模型名称没有类型，则默认为模型名称为模型名称+.json，此时服务器会在项目根目录(main.py)所在目录中寻找
# 如果配置模型地址，则必须配置模型的绝对路径，此字段为代码中引用，相对路径大概率会导致无法找到模型
SEND_MSG_CONFIG_FILE=sendMsgConfig.json

# =============================================================================
# 摄像头设置
# =============================================================================

# 自动曝光设置
# 通常在 Linux/Mac (V4L2/UVC) 下: 0 = 手动模式, 1 = 自动模式
# 在 Windows (DirectShow/MediaFoundation) 下: 行为可能不同，有时需要设为 0.25 或其他值来强制手动，但通常 0 或 1 是标准。
# 尝试设置为 0 (手动) 或 1 (如果 0 无效，有些驱动逻辑是反的，但在 OpenCV 标准中 0 通常是关闭自动)
CAP_PROP_AUTO_EXPOSURE=0
# 设置手动曝光值
# 值通常是 -13, -12, ..., 0, 1 等。
# 注意：很多摄像头这个值是 log 基准的，或者是负数表示曝光时间缩短。
# 常见范围是 -13 (最暗) 到 0 (最亮)，或者 0 到 100。需要根据具体摄像头测试。
CAP_PROP_EXPOSURE=-6
# 编码格式设置(MJPG,YUYV,H264,NV12)
CAP_PROP_FOURCC=MJPG
# 帧率设置
CAP_PROP_FPS=30
# 宽高设置
CAP_PROP_FRAME_WIDTH=1280
CAP_PROP_FRAME_HEIGHT=1024